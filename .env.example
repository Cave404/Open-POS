# Core Security
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex-string
FERNET_KEY=

# Application Server
PORT=5000
HOST=0.0.0.0

# Database Engine (Options: 'sqlite' or 'postgres')
DB_ENGINE=sqlite
DB_NAME=pos_store.db

# Target PostgreSQL Configuration (if DB_ENGINE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=

# Business & Store Defaults
STORE_NAME="Open-POS System"
STORE_LEGAL_ENTITY="Your Retail Store LLC"
STORE_LOCATION="Your City, State"
DAILY_TRADE_LIMIT=10
CASH_PAYOUT_PERCENT=60.0
CREDIT_PAYOUT_PERCENT=80.0